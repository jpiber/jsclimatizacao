# Supabase: use a Connection string do Transaction Pooler (porta 6543).
# URL direta (porta 5432) tambem funciona para o Alembic, mas nao e recomendada
# para o runtime com varias conexoes.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres

# Necessario apenas para scripts/migrate_mongo_to_supabase.py e para o backend
# enquanto a origem MongoDB ainda estiver sendo usada.
MONGO_URL=mongodb://localhost:27017
DB_NAME=jsclimatizacao

CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
APP_TZ=America/Sao_Paulo
OWNER_EMAIL=seu-email@example.com
OWNER_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-um-valor-aleatorio-longo
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=JS Climatizacao
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=